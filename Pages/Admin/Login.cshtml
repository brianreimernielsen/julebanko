@page
@model Julebanko.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = Localizer["AdminLogin"].Value;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="login-wrap">
        <div class="login-card">
            <h1>@Localizer["AdminLogin"]</h1>
            <p class="muted">Julebanko</p>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-error">@Localizer["InvalidLogin"]</div>
            }
            <form method="post" class="form-stack">
                <label>
                    @Localizer["Username"]
                    <input asp-for="Username" autocomplete="username" required />
                </label>
                <label>
                    @Localizer["Password"]
                    <input asp-for="Password" type="password" autocomplete="current-password" required />
                </label>
                <button class="btn btn-primary" type="submit">@Localizer["Login"]</button>
            </form>
            <p class="muted" style="margin-top:1rem;"><a href="/">@Localizer["BackToPlayer"]</a></p>
        </div>
    </div>
</body>
</html>
