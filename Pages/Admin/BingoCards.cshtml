@page
@model Julebanko.Pages.Admin.BingoCardsModel
@{
    ViewData["Title"] = Localizer["BingoCards"].Value;
}
<div class="admin-card">
    <h2>@Localizer["BingoCardsGenerate"]</h2>
    <p class="muted">@Localizer["BingoCardsGenerateHint"]</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" asp-page-handler="Generate" class="form-stack">
        <label>
            @Localizer["BingoPlateCount"]
            <input asp-for="PlateCount" type="number" min="1" max="500" required />
        </label>
        <label>
            @Localizer["BingoPlatesPerPage"]
            <select asp-for="PlatesPerPage">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="6">6</option>
                <option value="8">8</option>
                <option value="9">9</option>
            </select>
        </label>
        <label>
            @Localizer["BingoBannerOverride"]
            <input asp-for="BannerText" maxlength="200" placeholder="@Localizer["BingoBannerOverrideHint"]" />
        </label>
        <label>
            @Localizer["BingoBatchNote"]
            <input asp-for="Note" maxlength="500" />
        </label>
        <button class="btn btn-primary" type="submit">@Localizer["BingoGenerateDownload"]</button>
    </form>
</div>

@if (Model.IsSetup)
{
    <div class="admin-card">
        <h2>@Localizer["BingoSettings"]</h2>
        @if (Model.SettingsSaved)
        {
            <div class="alert alert-success">@Localizer["Saved"]</div>
        }
        <form method="post" asp-page-handler="SaveSettings" class="form-stack">
            <label class="checkbox-row">
                <input asp-for="BingoAutoValidate" type="checkbox" />
                @Localizer["BingoAutoValidate"]
            </label>
            <p class="muted" style="margin-top:0;">@Localizer["BingoAutoValidateHint"]</p>
            <label class="checkbox-row">
                <input asp-for="BingoPrizeOncePerType" type="checkbox" />
                @Localizer["BingoPrizeOncePerType"]
            </label>
            <p class="muted" style="margin-top:0;">@Localizer["BingoPrizeOncePerTypeHint"]</p>
            <label>
                @Localizer["BingoBannerText"]
                <input asp-for="BingoBannerText" maxlength="200" />
            </label>
            <label>
                @Localizer["BingoPrimaryColor"]
                <input asp-for="BingoPrimaryColor" maxlength="20" placeholder="#8B1E1E" />
            </label>
            <label>
                @Localizer["BingoAccentColor"]
                <input asp-for="BingoAccentColor" maxlength="20" placeholder="#D4A017" />
            </label>
            <label class="checkbox-row">
                <input asp-for="BingoFestiveLook" type="checkbox" />
                @Localizer["BingoFestiveLook"]
            </label>
            <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
        </form>
    </div>
}

<div class="admin-card">
    <h2>@Localizer["BingoBatches"]</h2>
    @if (Model.Batches.Count == 0)
    {
        <p class="empty-note">@Localizer["BingoNoBatches"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Localizer["BingoPlateCount"]</th>
                    <th>@Localizer["BingoPlatesPerPage"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Batches)
            {
                <tr>
                    <td>@b.Id · @b.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@b.PlateCount</td>
                    <td>@b.PlatesPerPage</td>
                    <td>
                        <a class="btn btn-ghost btn-small" href="@Url.Page("/Admin/BingoCards", "Download", new { batchId = b.Id })">@Localizer["BingoDownloadPdf"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="admin-card">
    <h2>@Localizer["BingoBrowse"]</h2>
    <form method="get" class="form-stack" style="margin-bottom:1rem;">
        <label>
            @Localizer["BingoSeriesNumber"]
            <input name="SeriesQuery" value="@Model.SeriesQuery" maxlength="32" />
        </label>
        <button class="btn btn-ghost" type="submit">@Localizer["BingoSearch"]</button>
    </form>
    <p class="muted">@Localizer["BingoShowing"]: @Model.Cards.Count / @Model.TotalCards</p>
    @if (Model.Cards.Count == 0)
    {
        <p class="empty-note">@Localizer["BingoNoCards"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@Localizer["BingoSeriesNumber"]</th>
                    <th>@Localizer["BingoHitRows"]</th>
                    <th>@Localizer["BingoWinStatus"]</th>
                    <th>@Localizer["BingoPreview"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Cards)
            {
                <tr>
                    <td><strong>@c.SeriesDisplay</strong> <span class="muted">(@Localizer["BingoBatch"] @c.BatchId)</span></td>
                    <td>
                        @if (c.HitRows.Count == 0)
                        {
                            <span class="muted">—</span>
                        }
                        else
                        {
                            @string.Join(", ", c.HitRows)
                        }
                    </td>
                    <td>
                        @if (c.HasApprovedWin)
                        {
                            @string.Join(", ", c.ApprovedWinTypes.Select(Model.WinLabel))
                        }
                        else
                        {
                            <span class="muted">@Localizer["BingoNoWin"]</span>
                        }
                    </td>
                    <td>
                        <div class="bingo-mini-grid" aria-hidden="true">
                            @for (var r = 0; r < 3; r++)
                            {
                                <div class="bingo-mini-row">
                                    @for (var col = 0; col < 9; col++)
                                    {
                                        var n = c.Grid[r, col];
                                        <span class="bingo-mini-cell@(n is null ? " empty" : "")">@(n?.ToString() ?? "")</span>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
