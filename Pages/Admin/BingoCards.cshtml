@page
@model Julebanko.Pages.Admin.BingoCardsModel
@{
    ViewData["Title"] = Localizer["BingoDesign"].Value;
}
<div class="admin-card">
    <h2>@Localizer["BingoCardsGenerate"]</h2>
    <p class="muted">@Localizer["BingoCardsGenerateHint"]</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post" asp-page-handler="Generate" class="form-stack">
        <label>
            @Localizer["BingoPageCount"]
            <input asp-for="PageCount" type="number" min="1" max="500" required />
        </label>
        <p class="muted" style="margin-top:0;">@Localizer["BingoPageCountHint"]</p>
        <label>
            @Localizer["BingoPlatesPerPage"]
            <select asp-for="PlatesPerPage">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="6">6</option>
                <option value="8">8</option>
                <option value="9">9</option>
            </select>
        </label>
        <label>
            @Localizer["BingoBannerOverride"]
            <input asp-for="BannerText" maxlength="200" placeholder="@Localizer["BingoBannerOverrideHint"]" />
        </label>
        <p class="muted" style="margin-top:0;">@Localizer["BingoBannerOverrideHelp"]</p>
        <label>
            @Localizer["BingoBatchNote"]
            <input asp-for="Note" maxlength="500" />
        </label>
        <div class="form-actions-row">
            <button class="btn btn-primary" type="submit">@Localizer["BingoGenerateDownload"]</button>
            <button class="btn btn-ghost" type="button" data-bingo-preview-refresh>@Localizer["BingoRefreshPreview"]</button>
            <a class="btn btn-ghost" href="#" data-bingo-preview-download>@Localizer["BingoDownloadPreviewPdf"]</a>
        </div>
    </form>
</div>

<div class="admin-card" data-bingo-layout-preview
     data-preview-base="@Url.Page("/Admin/BingoCards", "Preview")">
    <h2>@Localizer["BingoLayoutPreview"]</h2>
    <p class="muted">@Localizer["BingoLayoutPreviewHint"]</p>
    <div class="bingo-preview-frame">
        <object class="bingo-preview-object"
                type="application/pdf"
                data=""
                aria-label="@Localizer["BingoLayoutPreview"]">
            <p class="muted">
                @Localizer["BingoPreviewFallback"]
                <a href="#" data-bingo-preview-download>@Localizer["BingoDownloadPreviewPdf"]</a>
            </p>
        </object>
    </div>
</div>

@if (Model.IsSetup)
{
    <div class="admin-card">
        <h2>@Localizer["BingoSettings"]</h2>
        @if (Model.SettingsSaved)
        {
            <div class="alert alert-success">@Localizer["Saved"]</div>
        }
        @if (!string.IsNullOrEmpty(Model.MediaMessage) && Model.MediaMessage is not "ok" and not "deleted")
        {
            <div class="alert @(Model.MediaError ? "alert-error" : "alert-success")">@Model.MediaMessage</div>
        }
        else if (Model.MediaMessage == "deleted")
        {
            <div class="alert alert-success">@Localizer["Deleted"]</div>
        }
        <form method="post" asp-page-handler="SaveSettings" class="form-stack" id="bingo-settings-form">
            <label class="checkbox-row">
                <input asp-for="BingoAutoValidate" type="checkbox" />
                @Localizer["BingoAutoValidate"]
            </label>
            <p class="muted" style="margin-top:0;">@Localizer["BingoAutoValidateHint"]</p>
            <label class="checkbox-row">
                <input asp-for="BingoPrizeOncePerType" type="checkbox" />
                @Localizer["BingoPrizeOncePerType"]
            </label>
            <p class="muted" style="margin-top:0;">@Localizer["BingoPrizeOncePerTypeHint"]</p>
            <label>
                @Localizer["BingoBannerText"]
                <input asp-for="BingoBannerText" maxlength="200" placeholder="@Localizer["BingoBannerTextHint"]" />
            </label>
            <p class="muted" style="margin-top:0;">@Localizer["BingoBannerTextHelp"]</p>

            <fieldset class="plate-scheme-picker">
                <legend>@Localizer["BingoPlateScheme"]</legend>
                <p class="muted" style="margin-top:0;">@Localizer["BingoPlateSchemeHint"]</p>
                <div class="plate-scheme-grid">
                    @foreach (var scheme in Model.PlateSchemes)
                    {
                        var selected = string.Equals(Model.BingoPlateScheme, scheme.Id, StringComparison.OrdinalIgnoreCase);
                        <label class="plate-scheme-option @(selected ? "is-selected" : null)">
                            <input type="radio" name="BingoPlateScheme" value="@scheme.Id" @(selected ? "checked" : null) />
                            <span class="plate-scheme-swatches" aria-hidden="true">
                                <span style="background:@scheme.ColorA"></span>
                                <span style="background:@scheme.ColorB"></span>
                            </span>
                            <span class="plate-scheme-name">@BingoPlateSchemes.LocalizedName(scheme, Model.UiCulture)</span>
                            <span class="plate-scheme-hex muted">@scheme.ColorA · @scheme.ColorB</span>
                        </label>
                    }
                </div>
            </fieldset>

            <partial name="_ColorPicker" model='new ColorPickerModel {
                Name = "BingoPdfBackgroundColor",
                Value = Model.BingoPdfBackgroundColor,
                Label = Localizer["BingoPdfBackgroundColor"].Value,
                Hint = Localizer["BingoPdfBackgroundColorHint"].Value
            }' />

            <partial name="_ColorPicker" model='new ColorPickerModel {
                Name = "BingoFrameColor",
                Value = Model.BingoFrameColor,
                Label = Localizer["BingoFrameColor"].Value,
                Hint = Localizer["BingoFrameColorHint"].Value
            }' />

            <partial name="_ColorPicker" model='new ColorPickerModel {
                Name = "BingoBannerColor",
                Value = Model.BingoBannerColor,
                Label = Localizer["BingoBannerColor"].Value,
                Hint = Localizer["BingoBannerColorHint"].Value
            }' />

            <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
        </form>

        <div class="pdf-bg-upload" style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--line);">
            <h3>@Localizer["BingoPdfBackgroundImage"]</h3>
            <p class="muted">@Localizer["BingoPdfBackgroundImageHint"]</p>
            @if (Model.PdfBackgroundAsset is not null)
            {
                <img class="media-preview" src="@Model.PdfBackgroundAsset.RelativePath?v=@Model.PdfBackgroundAsset.UploadedAt.Ticks" alt="@Model.PdfBackgroundAsset.FileName" />
                <p class="muted">@Model.PdfBackgroundAsset.FileName</p>
                <form method="post" asp-page-handler="DeletePdfBackground" style="margin-bottom:0.75rem;">
                    <button class="btn btn-danger btn-small" type="submit">@Localizer["Delete"]</button>
                </form>
            }
            <form method="post" enctype="multipart/form-data" asp-page-handler="UploadPdfBackground" class="form-stack" style="max-width:420px;">
                <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" required />
                <button class="btn btn-primary btn-small" type="submit">@Localizer["Upload"]</button>
            </form>
        </div>
    </div>
}

<div class="admin-card">
    <h2>@Localizer["BingoBatches"]</h2>
    @if (Model.Batches.Count == 0)
    {
        <p class="empty-note">@Localizer["BingoNoBatches"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Localizer["BingoPlateCount"]</th>
                    <th>@Localizer["BingoPlatesPerPage"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Batches)
            {
                <tr>
                    <td>@b.Id · @b.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@b.PlateCount</td>
                    <td>@b.PlatesPerPage</td>
                    <td>
                        <a class="btn btn-ghost btn-small" href="@Url.Page("/Admin/BingoCards", "Download", new { batchId = b.Id })">@Localizer["BingoDownloadPdf"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p class="muted">
    <a href="/Admin/BingoCheck">@Localizer["BingoCheck"]</a>
    — @Localizer["BingoCheckHint"]
</p>
