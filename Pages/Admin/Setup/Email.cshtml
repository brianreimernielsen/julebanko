@page
@model Julebanko.Pages.Admin.Setup.EmailModel
@{
    ViewData["Title"] = Localizer["ClaimEmail"].Value;
}
<div class="admin-card">
    <h2>@Localizer["ClaimEmail"]</h2>
    <p class="muted">@Localizer["SmtpHint"]</p>
    @if (Model.Saved)
    {
        <div class="alert alert-success">@Localizer["Saved"]</div>
    }
    <form method="post" class="form-stack" style="max-width:420px;" autocomplete="off">
        <label>
            @Localizer["NotifyTo"]
            <input asp-for="ClaimNotifyTo" type="email" required />
        </label>
        <label>
            @Localizer["MailFrom"]
            <input asp-for="MailFrom" type="email" required />
        </label>

        <h3 style="margin:1.25rem 0 0.35rem; font-size:1.05rem;">@Localizer["SmtpSettings"]</h3>
        <label>
            @Localizer["SmtpHost"]
            <input asp-for="SmtpHost" maxlength="200" required />
        </label>
        <label>
            @Localizer["SmtpPort"]
            <input asp-for="SmtpPort" type="number" min="1" max="65535" required />
        </label>
        <label style="display:flex; gap:0.55rem; align-items:center;">
            <input asp-for="SmtpUseSsl" type="checkbox" style="width:auto;" />
            @Localizer["SmtpUseSsl"]
        </label>
        <label>
            @Localizer["SmtpUsername"]
            <input asp-for="SmtpUsername" maxlength="200" autocomplete="off" />
        </label>
        <label>
            @Localizer["SmtpPassword"]
            <input asp-for="SmtpPassword" type="password" maxlength="200" autocomplete="new-password" placeholder="@(Model.PasswordIsSet ? Localizer["SmtpPasswordKeep"].Value : "")" />
        </label>
        <p class="muted" style="margin:0; font-size:0.9rem;">@Localizer["SmtpPasswordHint"]</p>

        <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
    </form>
</div>
