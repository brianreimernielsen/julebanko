@page
@model Julebanko.Pages.Admin.Setup.ThemeModel
@{
    ViewData["Title"] = Localizer["Theme"].Value;
}
<div class="admin-card">
    <h2>@Localizer["Theme"]</h2>
    @if (Model.Saved)
    {
        <div class="alert alert-success">@Localizer["Saved"]</div>
    }
    <form method="post" class="form-stack" id="theme-form">
        <label>
            Season title
            <input asp-for="SeasonTitle" maxlength="200" />
        </label>
        <div class="field-row colors">
            <label>@Localizer["PlayerColors"] (bg)<input asp-for="PlayerBgColor" type="color" /></label>
            <label>@Localizer["AdminColors"] (bg)<input asp-for="AdminBgColor" type="color" /></label>
            <label>@Localizer["Accent"]<input asp-for="AccentColor" type="color" /></label>
        </div>
        <div class="field-row colors">
            <label>Player text<input asp-for="PlayerTextColor" type="color" /></label>
            <label>Admin text<input asp-for="AdminTextColor" type="color" /></label>
        </div>
        <label style="display:flex; gap:0.55rem; align-items:center;">
            <input asp-for="PlayerSnowEnabled" type="checkbox" style="width:auto;" />
            Falling snow on player page
        </label>
        <label>
            Snow intensity (1 = light, 5 = high)
            <select asp-for="PlayerSnowIntensity">
                <option value="1">1 — Light</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5 — High</option>
            </select>
        </label>
        <label style="display:flex; gap:0.55rem; align-items:center;">
            <input asp-for="PlayerSnowGroundEnabled" type="checkbox" style="width:auto;" id="snow-ground-toggle" />
            Snow ground strip on player page
        </label>
        <p class="form-hint" style="margin:0; opacity:0.85; font-size:0.92rem;">
            The ground strip is a fixed feature image (not uploadable). The Christmas elf walks on it and requires the strip.
        </p>
        <label style="display:flex; gap:0.55rem; align-items:center;">
            <input asp-for="PlayerNisseEnabled" type="checkbox" style="width:auto;" id="nisse-toggle" />
            Christmas elf (nisse) on player page
        </label>
        <p class="form-hint" id="nisse-requires-snow" style="margin:0; opacity:0.85; font-size:0.92rem;">
            Nisse requires the snow ground strip. Turning the strip off also turns the nisse off; enabling the nisse turns the strip on.
        </p>
        <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
    </form>
</div>
@section Scripts {
<script>
(() => {
  const snowGround = document.getElementById("snow-ground-toggle");
  const nisse = document.getElementById("nisse-toggle");
  if (!snowGround || !nisse) return;

  const sync = () => {
    if (!snowGround.checked) {
      nisse.checked = false;
      nisse.disabled = true;
    } else {
      nisse.disabled = false;
    }
  };

  snowGround.addEventListener("change", () => {
    if (!snowGround.checked) nisse.checked = false;
    sync();
  });

  nisse.addEventListener("change", () => {
    if (nisse.checked) {
      snowGround.checked = true;
      nisse.disabled = false;
    }
  });

  sync();
})();
</script>
}
