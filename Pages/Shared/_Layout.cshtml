@using System.Globalization
@using Julebanko.Data
@using Microsoft.AspNetCore.Mvc.Localization
@inject Julebanko.Services.SettingsService Settings
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var playerBg = await Settings.GetAsync(SettingKeys.PlayerBgColor, "#8B1E1E");
    var accent = await Settings.GetAsync(SettingKeys.AccentColor, "#D4A017");
    var playerText = await Settings.GetAsync(SettingKeys.PlayerTextColor, "#FFF8F0");
    var snowRaw = await Settings.GetAsync(SettingKeys.PlayerSnowEnabled, "true");
    var snowEnabled = !string.Equals(snowRaw, "false", StringComparison.OrdinalIgnoreCase)
                      && snowRaw != "0";
    var intensityRaw = await Settings.GetAsync(SettingKeys.PlayerSnowIntensity, "1");
    if (!int.TryParse(intensityRaw, out var snowIntensity) || snowIntensity < 1 || snowIntensity > 5)
    {
        snowIntensity = 1;
    }
    var nisseRaw = await Settings.GetAsync(SettingKeys.PlayerNisseEnabled, "true");
    var nisseEnabled = !string.Equals(nisseRaw, "false", StringComparison.OrdinalIgnoreCase)
                       && nisseRaw != "0";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Julebanko</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --player-bg: @playerBg;
            --accent: @accent;
            --player-text: @playerText;
        }
    </style>
</head>
<body class="@(ViewData["BodyClass"] as string)">
    @if (snowEnabled)
    {
        <div class="snow" data-snow data-intensity="@snowIntensity" aria-hidden="true"></div>
    }
    @if (nisseEnabled)
    {
        <div class="nisse-stage" data-nisse aria-hidden="true">
            <div class="nisse" data-nisse-actor>
                <div class="nisse-inner">
                    <svg class="nisse-svg" viewBox="0 0 120 160" width="78" height="104" focusable="false">
                        <defs>
                            <pattern id="nisseHatRib" width="4" height="8" patternUnits="userSpaceOnUse">
                                <rect width="4" height="8" fill="#d42426" />
                                <rect x="0" width="1.4" height="8" fill="#b81c1e" opacity="0.55" />
                            </pattern>
                            <pattern id="nisseSweaterKnit" width="3" height="6" patternUnits="userSpaceOnUse">
                                <rect width="3" height="6" fill="#c81e20" />
                                <rect x="0" width="1" height="6" fill="#a8181a" opacity="0.55" />
                            </pattern>
                        </defs>
                        <ellipse class="nisse-shadow" cx="60" cy="150" rx="28" ry="6" fill="rgba(0,0,0,0.25)" />
                        <!-- boots -->
                        <path d="M34 138c0-4 6-7 14-7h8v14c-10 1-18-1-22-7z" fill="#1a1a1a" />
                        <path d="M86 138c0-4-6-7-14-7h-8v14c10 1 18-1 22-7z" fill="#1a1a1a" />
                        <!-- pants -->
                        <path d="M42 118h36c2 6 2 14 1 18H41c-1-4-1-12 1-18z" fill="#424242" />
                        <!-- sweater body -->
                        <path d="M36 78c2-10 10-16 24-16s22 6 24 16v40c0 6-8 10-24 10s-24-4-24-10V78z" fill="url(#nisseSweaterKnit)" />
                        <path d="M38 112h44" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" />
                        <path d="M38 117h44" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" />
                        <!-- snowflake -->
                        <g transform="translate(42 92)" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round">
                            <path d="M0-7v14M-7 0h14M-5-5l10 10M-5 5l10-10" />
                        </g>
                        <!-- arms + mittens -->
                        <g class="nisse-arm nisse-arm-l">
                            <path d="M38 86c-10 6-14 14-12 22" stroke="#c81e20" stroke-width="10" stroke-linecap="round" fill="none" />
                            <circle cx="26" cy="110" r="7.5" fill="#d42426" />
                            <circle cx="20" cy="108" r="3.2" fill="#d42426" />
                        </g>
                        <g class="nisse-arm nisse-arm-r">
                            <path d="M82 86c10 6 14 14 12 22" stroke="#c81e20" stroke-width="10" stroke-linecap="round" fill="none" />
                            <circle cx="94" cy="110" r="7.5" fill="#d42426" />
                            <circle cx="100" cy="108" r="3.2" fill="#d42426" />
                        </g>
                        <!-- beard (covers eyes) -->
                        <path d="M28 70c4 28 20 42 32 42s28-14 32-42c-8 10-20 14-32 14S36 80 28 70z" fill="#ffffff" />
                        <path d="M34 104c6 6 14 10 26 10s20-4 26-10" fill="none" stroke="#e8e8e8" stroke-width="2" />
                        <!-- nose + cheeks + smile under hat brim -->
                        <circle cx="48" cy="72" r="4.5" fill="#f9c5bc" />
                        <circle cx="72" cy="72" r="4.5" fill="#f9c5bc" />
                        <circle cx="60" cy="70" r="7.5" fill="#f7a794" />
                        <path d="M56 78c2.2 2.4 5.8 2.4 8 0" fill="none" stroke="#5b3a34" stroke-width="1.5" stroke-linecap="round" />
                        <!-- floppy ribbed hat -->
                        <path d="M28 68c2-28 14-48 32-54 10 18 18 34 14 54H28z" fill="url(#nisseHatRib)" />
                        <path d="M60 14c10 6 22 20 28 36-8-4-16-8-22-8-2-10-4-18-6-28z" fill="url(#nisseHatRib)" />
                        <path d="M24 66c2 8 16 14 36 14s34-6 36-14c-4 5-18 9-36 9s-32-4-36-9z" fill="url(#nisseHatRib)" />
                        <ellipse cx="60" cy="68" rx="34" ry="7" fill="#c81e20" />
                        <path d="M30 66c6 5 20 8 30 8s24-3 30-8" fill="none" stroke="#a8181a" stroke-width="1.2" opacity="0.45" />
                        <circle cx="90" cy="48" r="5.5" fill="#ffffff" />
                        <!-- props for scenarios -->
                        <g class="nisse-bowl" opacity="0">
                            <ellipse cx="102" cy="118" rx="11" ry="4.5" fill="#e7e5e4" />
                            <path d="M91 118v-4c0-2.5 5-4.5 11-4.5s11 2 11 4.5v4" fill="#d6d3d1" />
                            <ellipse cx="102" cy="114" rx="9.5" ry="3" fill="#f5f5f4" />
                            <circle cx="99" cy="113.5" r="1.3" fill="#fbbf24" />
                            <circle cx="105" cy="114" r="1.1" fill="#f59e0b" />
                        </g>
                        <g class="nisse-rag" opacity="0">
                            <path d="M98 104c8 2 11 8 7 12" stroke="#fde68a" stroke-width="3.5" stroke-linecap="round" fill="none" />
                        </g>
                    </svg>
                </div>
            </div>
        </div>
    }
    <div class="site-shell">
        <div class="topbar">
            <div class="lang-switch" aria-label="@Localizer["Language"]">
                <a class="@(culture == "da" ? "active" : null)" href="/Culture?culture=da&amp;returnUrl=@Uri.EscapeDataString(returnUrl)">DA</a>
                <a class="@(culture == "en" ? "active" : null)" href="/Culture?culture=en&amp;returnUrl=@Uri.EscapeDataString(returnUrl)">EN</a>
                <a class="@(culture == "sv" ? "active" : null)" href="/Culture?culture=sv&amp;returnUrl=@Uri.EscapeDataString(returnUrl)">SV</a>
            </div>
            <a class="top-link" href="/Admin">Admin</a>
        </div>
        @RenderBody()
        <footer class="site-footer">Julebanko</footer>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
