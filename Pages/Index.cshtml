@page
@model Julebanko.Pages.IndexModel
@{
    ViewData["Title"] = Model.SeasonTitle;
    ViewData["BodyClass"] = string.IsNullOrEmpty(Model.BackgroundUrl) ? "" : "has-bg-image";
}
@if (!string.IsNullOrEmpty(Model.BackgroundUrl))
{
    <style>
        body.has-bg-image {
            background-image:
                linear-gradient(180deg, rgba(40, 8, 8, 0.55), rgba(40, 8, 8, 0.72)),
                url('@Model.BackgroundUrl');
        }
    </style>
}

<section class="hero hero-compact">
    <div class="hero-media"@if (!string.IsNullOrEmpty(Model.HeroUrl)) { <text> style="background-image:url(@Model.HeroUrl);" </text> }></div>
    <div class="hero-content">
        <p class="hero-kicker">@DateTime.Now.Year</p>
        <div class="brand-row">
            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <img class="hero-logo" src="@Model.LogoUrl" alt="" />
            }
            <h1 class="brand">@Model.BrandName</h1>
        </div>
        <p class="hero-lead">@Model.SeasonTitle</p>
        <div class="cta-row">
            <a class="btn btn-primary" href="#numbers">@Localizer["TodaysNumbers"]</a>
            <a class="btn btn-ghost" href="#claim">@Localizer["HaveYouWon"]</a>
        </div>
    </div>
</section>

<section class="section section-player" id="numbers">
    <div class="julebanko-paneler numbers-grid">
        <div class="player-panel number-panel juleramme juleramme--glimt">
            <div class="number-block">
                <h2 class="block-heading">@Localizer["TodaysNumbers"]</h2>
                @if (Model.TodayNumbers.Count == 0)
                {
                    <p class="empty-note">@Localizer["NoNumbersYet"]</p>
                }
                else
                {
                    <div class="ball-row">
                        @foreach (var n in Model.TodayNumbers)
                        {
                            <span class="ball">@n.Number</span>
                        }
                    </div>
                }
            </div>

            <div class="number-block">
                <h3>@Localizer["AllNumbersDrawOrder"]</h3>
                @if (Model.AllDrawOrder.Count == 0)
                {
                    <p class="empty-note">@Localizer["NoNumbersYet"]</p>
                }
                else
                {
                    <div class="ball-row dense">
                        @foreach (var n in Model.AllDrawOrder)
                        {
                            <span class="ball chip">@n.Number</span>
                        }
                    </div>
                }
            </div>

            <div class="number-block">
                <h3>@Localizer["AllNumbersSorted"]</h3>
                @if (Model.AllSorted.Count == 0)
                {
                    <p class="empty-note">@Localizer["NoNumbersYet"]</p>
                }
                else
                {
                    <div class="ball-row dense">
                        @foreach (var n in Model.AllSorted)
                        {
                            <span class="ball chip">@n</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="player-panel claim-panel juleramme juleramme--glimt" id="claim">
            <h2>@Localizer["HaveYouWon"]</h2>
            <p class="claim-hint">@Localizer["ClaimHint"]</p>
            @if (Model.StatusMessage == "ok")
            {
                <div class="alert alert-success">@Localizer["ClaimSubmitted"]</div>
            }
            else if (Model.StatusIsError)
            {
                <div class="alert alert-error">@Localizer["YourName"]</div>
            }
            <form method="post" class="form-stack">
                <label>
                    @Localizer["YourName"]
                    <input asp-for="PlayerName" maxlength="120" required />
                </label>
                <label>
                    @Localizer["WinType"]
                    <select asp-for="WinType">
                        <option value="@((int)WinType.OneRow)">@Localizer["OneRow"]</option>
                        <option value="@((int)WinType.TwoRows)">@Localizer["TwoRows"]</option>
                        <option value="@((int)WinType.FullBoard)">@Localizer["FullBoard"]</option>
                    </select>
                </label>
                <button class="btn btn-primary" type="submit">@Localizer["Send"]</button>
            </form>
        </div>

        <div class="player-panel winners-panel juleramme juleramme--glimt">
            <h2>@Localizer["Winners"]</h2>
            @if (Model.ApprovedWinners.Count == 0)
            {
                <p class="empty-note">@Localizer["NoWinnersYet"]</p>
            }
            else
            {
                <ul class="winner-list">
                    @foreach (var w in Model.ApprovedWinners)
                    {
                        <li>
                            <strong>@w.PlayerName</strong>
                            <span>@Model.WinLabel(w.WinType)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>
